# VoltFlow Mate command daemon config — copy to /data/local/tmp/voltflow_cmd.conf
# Values mirror the in-app Cloud Sync settings (SettingsRepository KEY_CLOUD_SYNC_*).
#
# url: the telemetry endpoint (…/api/bydmate/telemetry) OR the commands endpoint directly.
#      The daemon derives <base>/commands and <base>/commands/ack from it.
url=https://voltflow.life/api/bydmate/telemetry
api_key=REPLACE_WITH_CLOUD_SYNC_API_KEY
vehicle_id=REPLACE_WITH_VEHICLE_ID
